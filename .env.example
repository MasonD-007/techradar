# GitHub Configuration
GITHUB_OWNER=your-github-username
GITHUB_REPO=your-repo-name
IMAGE_REGISTRY=ghcr.io

# Database Configuration
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=appdb
DATABASE_URL=postgres://app:change-me-in-production@localhost:5432/appdb

# Auth Configuration
JWT_SECRET=your-secret-key-change-in-production
TOKEN_EXPIRY_HOUR=24

# Ingress Configuration
INGRESS_HOST=nextjs-template.lan

# Public site URL used for absolute link-preview image URLs
# Runtime variable (read per request); preferred over NEXT_PUBLIC_SITE_URL
SITE_URL=http://localhost:3000
# Legacy fallback (build-time inlined)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
